# Copier vers .env (jamais commité). Sur Vercel : Settings > Environment Variables.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
PIXABAY_API_KEY=
# Postgres (Neon) — pas encore utilisé par l'app
DATABASE_URL=
DATABASE_URL_POOLED=
# Optionnel
# OPENROUTER_FREE_MODELS=google/gemma-4-31b-it:free
# OPENROUTER_MODEL=google/gemini-2.5-flash   (payant, dernier recours ; OPENROUTER_PAID=0 pour l'interdire)
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image   (décor IA, payant, option)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION=1   (si le modèle Groq choisi accepte les images)
# PORT=3000
# Paiement Stripe (page d'accueil)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# STRIPE_MODE=subscription   (ou payment pour un achat unique)
# PLANS_JSON=[{"id":"free","name":"Découverte","price":"0 €","features":["..."]}]
# Comptes (base Neon) et webhook Stripe
# SESSION_SECRET=   (64 caractères hexadécimaux aléatoires)
# STRIPE_WEBHOOK_SECRET=whsec_...   (endpoint : /api/stripe-webhook)
# E-mails (Resend) : le domaine de EMAIL_FROM doit être vérifié dans Resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=ClipMotion <hello@clipmotion.ai>
# PUBLIC_URL=https://clipmotion.ai
