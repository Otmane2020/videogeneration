# Copier vers .env (jamais commité). Sur Vercel : Settings > Environment Variables.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
PIXABAY_API_KEY=
# Postgres (Neon) — pas encore utilisé par l'app
DATABASE_URL=
DATABASE_URL_POOLED=
# Optionnel
# OPENROUTER_EMBER_MODEL=meta/muse-ember   (script de la vidéo, 1 appel par vidéo ; 0 pour le couper)
# OPENROUTER_FREE_MODELS=google/gemma-4-31b-it:free
# OPENROUTER_MODEL=google/gemini-2.5-flash   (payant, dernier recours ; OPENROUTER_PAID=0 pour l'interdire)
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image   (décor IA, payant, option)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION=1   (si le modèle Groq choisi accepte les images)
# PORT=3000
# Paiement Stripe (page d'accueil)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# STRIPE_MODE=subscription   (ou payment pour un achat unique)
# PLANS_JSON=[{"id":"free","name":"Découverte","price":"0 €","features":["..."]}]
# Comptes (base Neon) et webhook Stripe
# SESSION_SECRET=   (64 caractères hexadécimaux aléatoires)
# STRIPE_WEBHOOK_SECRET=whsec_...   (endpoint : /api/stripe-webhook)
# E-mails (Resend) : le domaine de EMAIL_FROM doit être vérifié dans Resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=ClipMotion <hello@clipmotion.ai>
# PUBLIC_URL=https://clipmotion.ai
# Avis clients affichés sur la page d'accueil (vrais avis uniquement) et quotas mensuels
# TESTIMONIALS_JSON=[{"name":"...","role":"...","quote":"...","photo":"https://...","stars":5}]
# QUOTA_FREE=3
# QUOTA_PRO=30
# QUOTA_BUSINESS=150
# FREE_ACCOUNTS_PER_IP=1
# Administration, compte rendu quotidien, e-mails reçus
# ADMIN_EMAILS=you@example.com
# CRON_SECRET=   (chaîne aléatoire ; Vercel l'envoie à /api/report chaque matin)
# INBOUND_KEY=   (clé de l'adresse de webhook Resend : /api/inbound?key=...)
# Notifications push (paire de clés VAPID ; clé privée = PEM encodé en base64)
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# Détourage : ClearBackdrop uniquement (https://clearbackdrop.com/account), aucun service de secours
# CLEARBACKDROP_API_KEY=
# Décors IA gratuits — Cloudflare Workers AI (FLUX, Apache 2.0)
# https://dash.cloudflare.com → AI → overview → Manage API tokens
# CF_ACCOUNT_ID=
# CF_AI_TOKEN=

# Logos de marques : Brandfetch Logo API (identifiant client public) ; sans lui, Iconify sert de secours
BRANDFETCH_CLIENT_ID=
