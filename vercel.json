{
  "cleanUrls": true,
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/track", "destination": "/api/ops?a=track" },
    { "source": "/api/admin", "destination": "/api/ops?a=admin" },
    { "source": "/api/inbound", "destination": "/api/ops?a=inbound" },
    { "source": "/api/push", "destination": "/api/ops?a=push" }
  ],
  "crons": [{ "path": "/api/ops?a=report", "schedule": "0 7 * * *" }]
}
